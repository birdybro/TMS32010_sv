[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 12

[engines]
smtbmc bitwuzla

[script]
read -formal -sv tms32010_pkg.sv
read -formal -sv tms32010_decode.sv
read -formal -sv tms32010_internal_ram.sv
read -formal -sv tms32010_multiplier.sv
read -formal -sv tms32010_input_shifter.sv
read -formal -sv tms32010_output_shifter.sv
read -formal -sv tms32010_accumulator.sv
read -formal -sv tms32010_fetch_execute.sv
read -formal -sv tms32010_core.sv
read -formal -sv tms32010_program_bus.sv
read -formal -sv tms32010_sequential_pipeline_slice.sv
read -formal -sv tms32010_mister.sv
read -formal -sv hard_drivin_sound_bus_decode.sv
read -formal -sv hard_drivin_sound_program_ram.sv
read -formal -sv hard_drivin_sound_address_control.sv
read -formal -sv hard_drivin_sound_communication_ram.sv
read -formal -sv hard_drivin_sound_communication_path.sv
read -formal -sv hard_drivin_sound_rom_path.sv
read -formal -sv hard_drivin_sound_dac_latch.sv
read -formal -sv hard_drivin_sound_320_port_latch.sv
read -formal -sv hard_drivin_sound_output_control.sv
read -formal -sv hard_drivin_sound_bio_generator.sv
read -formal -sv hard_drivin_sound_host_control.sv
read -formal -sv hard_drivin_mc68000_write_word.sv
read -formal -sv hard_drivin_sound_mailboxes.sv
read -formal -sv hard_drivin_sound_read_status.sv
read -formal -sv hard_drivin_sound_switches.sv
read -formal -sv hard_drivin_sound_host_read_mux.sv
read -formal -sv hard_drivin_sound_host_timing.sv
read -formal -sv hard_drivin_sound_local_memory_decode.sv
read -formal -sv hard_drivin_sound_local_memory_bridge.sv
read -formal -sv hard_drivin_sound_direct_io.sv
read -formal -sv hard_drivin_sound_local_ram.sv
read -formal -sv hard_drivin_sound_local_reset_interlock.sv
read -formal -sv hard_drivin_sound_mister.sv
read -formal -sv hard_drivin_sound_host_routing_formal.sv
prep -top hard_drivin_sound_host_routing_formal

