[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 18
cover: mode cover
cover: depth 18

[engines]
smtbmc bitwuzla

[script]
read -formal -sv tms32010_pkg.sv
read -formal -sv tms32010_decode.sv
read -formal -sv tms32010_internal_ram.sv
read -formal -sv tms32010_multiplier.sv
read -formal -sv tms32010_input_shifter.sv
read -formal -sv tms32010_output_shifter.sv
read -formal -sv tms32010_auxiliary_counter.sv
read -formal -sv tms32010_status_word.sv
read -formal -sv tms32010_stack.sv
read -formal -sv tms32010_accumulator.sv
read -formal -sv tms32010_core.sv
read -formal -sv tms32010_interrupt_branch_formal.sv
prep -top tms32010_interrupt_branch_formal

[files]
rtl/packages/tms32010_pkg.sv
rtl/core/tms32010_decode.sv
rtl/core/tms32010_internal_ram.sv
rtl/core/tms32010_multiplier.sv
rtl/core/tms32010_input_shifter.sv
rtl/core/tms32010_output_shifter.sv
rtl/core/tms32010_auxiliary_counter.sv
rtl/core/tms32010_status_word.sv
rtl/core/tms32010_stack.sv
rtl/core/tms32010_accumulator.sv
rtl/core/tms32010_core.sv
formal/tms32010_interrupt_branch_formal.sv
